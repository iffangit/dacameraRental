# ============================================================
#  คัดลอกเป็น .env.docker แล้วแก้ค่า — ใช้เฉพาะตอนรันด้วย docker compose
#      cp .env.docker.example .env.docker
#  ไฟล์ .env.docker ถูก .gitignore ไว้ ห้ามใส่ค่าจริงในไฟล์ตัวอย่างนี้
#
#  ไฟล์นี้ถูกส่งเข้าทั้ง container db และ container app
#  จึงมีรหัสผ่านอยู่สองที่: ตัวที่ MySQL ใช้ตั้งค่าตอนสร้างฐานข้อมูล
#  กับตัวที่อยู่ใน DATABASE_URL ของแอป — ต้องตรงกัน
# ============================================================

# ---- container db (mysql 8.4) ----
# ตั้งเองได้ตามใจ ไม่ต้องตรงกับรหัสของ XAMPP
# ห้ามใช้อักขระ @ : / ? # เพราะต้องเอาไปต่อเป็น URL ด้านล่าง
MYSQL_ROOT_PASSWORD=change-me-please
MYSQL_DATABASE=dacamera_rental
TZ=Asia/Bangkok

# ---- container app ----
# host เป็น "db" ตามชื่อ service ใน docker-compose.yml ไม่ใช่ 127.0.0.1
# รหัสผ่านและชื่อฐานข้อมูลต้องตรงกับสองบรรทัดบน
DATABASE_URL="mysql://root:change-me-please@db:3306/dacamera_rental"

# ใช้เซ็น JWT ของ session ต้องยาวอย่างน้อย 32 ตัวอักษร
# สร้างใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# ---- Gemini API ----
# ขอ key ได้ที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# ---- ที่เก็บรูปที่อัปโหลด ----
# ไม่ตั้งก็ได้ — ค่าเริ่มต้นคือ data/uploads/ ใน root ของโปรเจกต์
# (ไม่ได้อยู่ใน public/ เพราะ next start อ่านรายชื่อไฟล์ใน public/ แค่ตอนบูต
#  รูปที่เพิ่งอัปโหลดจะขึ้น 404 จนกว่าจะรีสตาร์ท — ดู src/lib/uploads.js)
UPLOAD_DIR=""
