# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ยกเว้นไฟล์ตัวอย่างที่ไม่มีค่าจริง — ต้อง commit ไว้ให้คนอื่นรู้ว่าต้องตั้งค่าอะไรบ้าง
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# output ของ next build (แยกจาก .next ของ dev server)
/.next-build/

# รูปที่อัปโหลด — เก็บไฟล์จริงไว้ในเครื่อง ไม่ commit ขึ้น repo
/public/uploads/*
!/public/uploads/.gitkeep
