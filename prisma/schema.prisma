// ============================================================
//  Smart Camera & Equipment Rental Management System
//  Prisma Schema — อ้างอิงจาก requirements.md (SRS v1.0.0)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URL ย้ายไปอยู่ที่ prisma.config.ts (สำหรับ Migrate)
// ส่วนตอน runtime ส่งผ่าน driver adapter ใน src/lib/prisma.js
datasource db {
  provider = "mysql"
}

// ------------------------------------------------------------
//  ENUMS
// ------------------------------------------------------------

/// สิทธิ์การใช้งาน — SRS §2 User Roles & Access Matrix
enum Role {
  MEMBER // ลูกค้าที่ลงทะเบียน
  VIP //    สมาชิกประวัติดี (Grade A/B) — คิวด่วน, มัดจำอัตราพิเศษ
  ADMIN //  เจ้าของร้าน / ผู้ดูแลระบบ
}

/// เกรดความเสี่ยงลูกค้า — REQ-RISK-001
/// A = ประวัติดีเยี่ยม (มัดจำ 20%), B = ปกติ (50%), C = เสี่ยง (100%)
enum CustomerGrade {
  A
  B
  C
}

/// สถานะอุปกรณ์รายชิ้น — REQ-RENT-001
enum UnitStatus {
  AVAILABLE //   ว่าง
  RENTED //      ถูกเช่า
  MAINTENANCE // อยู่ระหว่างส่งซ่อม
  CLEANING //    รอทำความสะอาด
  RETIRED //     ปลดระวาง (Soft Delete)
}

/// Workflow ออเดอร์ — REQ-RENT-005
/// PENDING_APPROVAL → APPROVED → ACTIVE_RENTAL → RETURNED_INSPECTED → CLOSED
/// (หรือ CANCELLED / REJECTED ได้ก่อนอนุมัติ)
enum OrderStatus {
  PENDING_APPROVAL
  APPROVED
  ACTIVE_RENTAL
  RETURNED_INSPECTED
  CLOSED
  CANCELLED
  REJECTED
}

/// สภาพอุปกรณ์ตอนรับคืน — REQ-RISK-002 / REQ-RENT-005
enum ReturnCondition {
  GOOD //            ปกติ พร้อมปล่อยเช่าต่อ
  NEEDS_CLEANING //  ใช้งานได้แต่ต้องทำความสะอาดก่อน
  DAMAGED //         พบความเสียหาย ต้องส่งซ่อม
}

/// ช่องทางที่เกิดการเช่า
enum RentalChannel {
  ONLINE //  ลูกค้ายื่นคำขอผ่านเว็บ ต้องรออนุมัติ
  WALK_IN // ลูกค้าเดินเข้าร้าน พนักงานทำรายการให้ รับของทันที
}

/// ช่วงเวลาที่บันทึกภาพตรวจสภาพ — REQ-RISK-002
enum InspectionPhase {
  BEFORE_HANDOVER // ก่อนส่งมอบ
  AFTER_RETURN //    เมื่อรับคืน
}

/// มุมถ่ายภาพบังคับ 4 มุม + รอยเดิม — REQ-RISK-002
enum PhotoAngle {
  FRONT
  BACK
  LEFT
  RIGHT
  EXISTING_DAMAGE
}

/// สถานะโพสการตลาดที่ AI ร่าง — REQ-AI-002
enum PostStatus {
  DRAFT //     AI ร่างแล้ว รอตรวจ
  APPROVED //  อนุมัติแล้ว รอเผยแพร่
  BROADCAST // เผยแพร่แล้ว
  REJECTED //  ไม่อนุมัติ
}

/// เหตุผลที่เข้าสู่รอบบำรุงรักษา — REQ-RISK-003
enum MaintenanceReason {
  RENTAL_CYCLE_LIMIT // ครบจำนวนรอบเช่า (เช่น 10 ครั้ง)
  USAGE_DAYS_LIMIT //   ครบจำนวนวันใช้งาน (เช่น 50 วัน)
  DAMAGE_REPORTED //    พบความเสียหายจากการตรวจสภาพ
  ROUTINE_CLEANING //   ทำความสะอาดตามปกติ
  MANUAL //             Admin สั่งเอง
}

/// ชนิดเหตุการณ์ที่แสดงใน activity feed หน้า Dashboard
enum ActivityType {
  ORDER_CREATED
  ORDER_APPROVED
  ORDER_REJECTED
  ORDER_RETURNED
  UNIT_MAINTENANCE
  INSPECTION_LOGGED
  AI_POST_GENERATED
  AI_POST_BROADCAST
  SETTING_CHANGED
}

// ------------------------------------------------------------
//  USERS
// ------------------------------------------------------------

model User {
  id Int @id @default(autoincrement())

  /// ลูกค้าที่เดินเข้ามาเช่าหน้าร้านไม่ต้องสมัครสมาชิก จึงอาจไม่มีอีเมล
  /// และล็อกอินไม่ได้ (passwordHash เป็น null) — MySQL ยอมให้ค่า NULL ซ้ำกันได้
  /// ในคอลัมน์ unique จึงมีลูกค้าหน้าร้านหลายคนพร้อมกันได้
  email        String? @unique @db.VarChar(191)
  passwordHash String? @db.VarChar(255) // bcrypt — SRS §4.2 Security
  fullName     String  @db.VarChar(120)
  phone        String? @db.VarChar(20)
  role         Role          @default(MEMBER)
  grade        CustomerGrade @default(B)

  /// คะแนนความเสี่ยง 0–100 (สูง = ดี) คำนวณจากประวัติการเช่า/คืนตรงเวลา/ความเสียหาย — REQ-RISK-001
  riskScore      Int     @default(70)
  totalRentals   Int     @default(0)
  onTimeReturns  Int     @default(0)
  lateReturns    Int     @default(0)
  damageIncidents Int    @default(0)

  /// ระงับสิทธิ์การใช้งาน (แทนการลบจริง) — SRS §3.4 CRUD Matrix
  isSuspended Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders           RentalOrder[]    @relation("OrderCustomer")
  approvedOrders   RentalOrder[]    @relation("OrderApprover")
  inspectionLogs   InspectionLog[]  @relation("InspectionInspector")
  approvedPosts    AiMarketingPost[] @relation("PostApprover")
  activities       ActivityLog[]
  settingChanges   ShopSetting[]
  returnedItems    RentalOrderItem[] @relation("ItemReturnedBy")

  @@index([role])
  @@index([grade])
  @@index([phone]) // ใช้ค้นลูกค้าเดิมตอนทำรายการหน้าร้าน
}

// ------------------------------------------------------------
//  SHOP SETTINGS
// ------------------------------------------------------------

/// ค่าตั้งค่าระดับร้าน — มีแถวเดียว (id = 1) เจ้าของร้านแก้เองได้ผ่านหน้า /settings
/// ทำเป็นตารางแทนค่าคงที่ในโค้ด เพื่อให้เปลี่ยนได้โดยไม่ต้อง deploy ใหม่
model ShopSetting {
  id Int @id @default(1)

  /// เงินมัดจำจองคิวต่อ 1 คำขอเช่า (ไม่ใช่ต่อชิ้น) หน่วยเป็นบาท
  bookingDeposit Decimal @db.Decimal(10, 2)

  updatedAt   DateTime @updatedAt
  updatedById Int?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
}

// ------------------------------------------------------------
//  EQUIPMENT CATALOG
// ------------------------------------------------------------

model Category {
  id        Int         @id @default(autoincrement())
  name      String      @unique @db.VarChar(80) // Camera Body, Lens, Gimbal, Lighting, Audio...
  code      String      @unique @db.VarChar(12)
  sortOrder Int         @default(0)
  equipments Equipment[]
}

/// ยี่ห้ออุปกรณ์ — เจ้าของร้านเพิ่ม/แก้เองได้ที่หน้าตั้งค่า
/// เดิมเก็บเป็นข้อความพิมพ์อิสระในตาราง Equipment ทำให้พิมพ์ต่างกันได้
/// (Sony / SONY / sony) และเอามาใช้ตั้งรหัส Serial ไม่ได้
model Brand {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(60) // Sony, Canon, Godox

  /// ตัวย่อที่ใช้ขึ้นต้นเลข Serial — เช่น SN → SN-A7M3-001
  code String @unique @db.VarChar(4)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  equipments Equipment[]
}

/// รุ่นอุปกรณ์ (ไม่ใช่ตัวเครื่อง) — ราคาและสเปกอยู่ที่นี่
model Equipment {
  id      Int    @id @default(autoincrement())
  name    String @db.VarChar(160) // เช่น "Sony A7 III"
  brandId Int

  /// รหัสรุ่นสั้น ๆ ใช้ประกอบเลข Serial — เช่น A7M3 → SN-A7M3-001
  /// เดิมรหัสนี้ซ่อนอยู่ในสตริง serial เฉย ๆ ไม่ได้ถูกบันทึกไว้ที่ไหน
  /// ทำให้ระบบเจนเลขต่อให้อัตโนมัติไม่ได้ จึงแยกออกมาเป็นฟิลด์
  code String? @unique @db.VarChar(16)
  categoryId  Int
  description String?  @db.Text
  imageUrl    String?  @db.VarChar(500)

  /// ค่าเช่าต่อวัน (บาท) — ใช้คำนวณใน REQ-RENT-004
  dailyRate    Decimal @db.Decimal(10, 2)
  /// มูลค่าทรัพย์สิน ใช้ประเมินค่าเสียหายตอนรับคืน (REQ-RISK-002)
  /// ไม่ได้ใช้คำนวณเงินมัดจำ — มัดจำเป็นค่าคงที่ที่ร้านตั้งเองใน ShopSetting
  replacementValue Decimal @db.Decimal(12, 2)

  /// Soft Delete — ซ่อนอุปกรณ์แทนการลบ (SRS §3.4)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand    Brand           @relation(fields: [brandId], references: [id])
  category Category        @relation(fields: [categoryId], references: [id])
  units    EquipmentUnit[]
  posts    AiMarketingPost[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
}

/// ตัวเครื่องรายชิ้นแยกตาม Serial Number — REQ-RENT-002
/// นี่คือหน่วยที่ถูกจอง ไม่ใช่ Equipment เพื่อกัน Double Booking
model EquipmentUnit {
  id           Int        @id @default(autoincrement())
  equipmentId  Int
  serialNumber String     @unique @db.VarChar(64)
  status       UnitStatus @default(AVAILABLE)

  /// ตัวนับสำหรับ auto-maintenance — REQ-RISK-003
  rentalCount    Int @default(0)
  totalDaysUsed  Int @default(0)
  /// เกณฑ์ที่ทำให้ระบบเปลี่ยนสถานะเป็น CLEANING/MAINTENANCE อัตโนมัติ
  cycleLimit     Int @default(10)
  usageDaysLimit Int @default(50)

  purchasedAt DateTime?
  notes       String?   @db.Text
  isActive    Boolean   @default(true) // Soft Delete

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment       Equipment           @relation(fields: [equipmentId], references: [id])
  orderItems      RentalOrderItem[]
  inspectionLogs  InspectionLog[]
  maintenanceLogs MaintenanceRecord[]

  @@index([equipmentId])
  @@index([status])
}

// ------------------------------------------------------------
//  RENTAL ORDERS & QUEUE
// ------------------------------------------------------------

/// คำขอเช่า 1 รายการ = 1 ออเดอร์ (มีได้หลายชิ้น) — REQ-RENT-003 Custom Bundle
model RentalOrder {
  id        Int           @id @default(autoincrement())
  orderCode String        @unique @db.VarChar(32) // ORD-2569-0184
  userId    Int
  status    OrderStatus   @default(PENDING_APPROVAL)
  channel   RentalChannel @default(ONLINE)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  /// จำนวนวันเช่า (inclusive) — snapshot ไว้กันสูตรเปลี่ยนภายหลัง
  rentalDays Int

  /// REQ-RENT-004 — ค่าเช่ารวมก่อนหักส่วนลด (ค่าเช่าต่อวัน × วัน ของทุกชิ้น)
  rentalFee Decimal @db.Decimal(12, 2)

  /// ส่วนลดที่เจ้าของร้านให้กับเซ็ตนี้ (บาท) — REQ-RENT-003
  /// เก็บแยกจาก rentalFee เพื่อให้ยังรู้ราคาเต็มและตรวจสอบย้อนหลังได้ว่าลดไปเท่าไร
  /// ยอดสุทธิ = rentalFee - discountAmount
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  discountNote   String? @db.VarChar(255) // เหตุผลที่ลด เช่น ลูกค้าประจำ

  /// เงินมัดจำจองคิวที่ลูกค้าจ่ายตอนยื่นคำขอ — หักเป็นส่วนหนึ่งของค่าเช่า
  /// ไม่ใช่เงินประกันความเสียหาย จึงไม่ผูกกับมูลค่าอุปกรณ์หรือเกรดลูกค้า
  /// เก็บเป็น snapshot เพราะถ้าร้านปรับค่ามัดจำภายหลัง ออเดอร์เก่าต้องไม่เปลี่ยนตาม
  /// ยอดที่ต้องจ่ายเพิ่มตอนรับของ = rentalFee - depositAmount
  depositAmount Decimal @db.Decimal(12, 2)

  /// เกรดของลูกค้า ณ เวลาที่ยื่นคำขอ — ใช้อธิบายลำดับการอนุมัติและสิทธิ์คิวด่วน
  gradeAtRequest CustomerGrade
  isRushRequest  Boolean       @default(false) // สิทธิ์คิวด่วนของ VIP

  customerNote String? @db.Text
  adminNote    String? @db.Text

  /// ค่าเช่าส่วนเกินรวมจากการคืนช้า (ผลรวมของ lateFee รายชิ้น)
  lateFee Decimal @default(0) @db.Decimal(12, 2)

  approvedById Int?
  approvedAt   DateTime?
  returnedAt   DateTime? // เวลาที่คืนครบทุกชิ้น

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer   User              @relation("OrderCustomer", fields: [userId], references: [id])
  approvedBy User?             @relation("OrderApprover", fields: [approvedById], references: [id])
  items      RentalOrderItem[]
  inspections InspectionLog[]

  @@index([userId])
  @@index([status])
  @@index([channel])
  @@index([startDate, endDate])
}

/// รายการอุปกรณ์ในออเดอร์ — แถวนี้คือ "การจองคิว" ของ EquipmentUnit 1 ชิ้น
///
/// กันจองซ้อน (NFR Data Integrity 100%):
/// MySQL ไม่มี exclusion constraint แบบ PostgreSQL จึงบังคับด้วย 2 ชั้น
///   1. ชั้น DB  : @@unique([equipmentUnitId, startDate]) กันจองวันเริ่มเดียวกันซ้ำตรง ๆ
///   2. ชั้น Logic: ใน transaction ทำ SELECT ... FOR UPDATE หา overlap
///                  (startDate <= ปลายช่วงใหม่ AND endDate >= ต้นช่วงใหม่)
///                  โดยนับเฉพาะออเดอร์ที่ status ยัง active อยู่ ก่อน INSERT
/// startDate/endDate ถูก denormalize ลงมาที่นี่เพื่อให้ query ปฏิทินคิว
/// (REQ-RENT-001) ไม่ต้อง join กลับไป RentalOrder — ตาม NFR Performance < 2 วินาที
model RentalOrderItem {
  id              Int @id @default(autoincrement())
  orderId         Int
  equipmentUnitId Int

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  dailyRate Decimal @db.Decimal(10, 2) // snapshot ราคา ณ วันจอง
  days      Int
  subtotal  Decimal @db.Decimal(12, 2)

  /// ---- การรับคืน (REQ-RENT-005) ----
  /// null = ยังไม่ได้คืน — ลูกค้าคืนไม่ครบในครั้งเดียวได้ จึงบันทึกรายชิ้น
  returnedAt      DateTime?
  returnCondition ReturnCondition?
  returnNote      String?          @db.VarChar(500)

  /// จำนวนวันที่คืนช้ากว่ากำหนด และค่าเช่าส่วนเกินที่เก็บเพิ่ม
  lateDays Int     @default(0)
  lateFee  Decimal @default(0) @db.Decimal(12, 2)

  returnedById Int?
  returnedBy   User? @relation("ItemReturnedBy", fields: [returnedById], references: [id])

  order RentalOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  unit  EquipmentUnit @relation(fields: [equipmentUnitId], references: [id])

  @@unique([equipmentUnitId, startDate])
  @@index([orderId])
  @@index([equipmentUnitId, startDate, endDate])
  @@index([returnedAt])
}

// ------------------------------------------------------------
//  RISK & ASSET MANAGEMENT
// ------------------------------------------------------------

/// บันทึกภาพสภาพอุปกรณ์ก่อน-หลังเช่า — REQ-RISK-002
/// ไม่มีการลบ (คงไว้เป็นหลักฐาน ตาม SRS §3.4)
model InspectionLog {
  id              Int             @id @default(autoincrement())
  orderId         Int
  equipmentUnitId Int
  phase           InspectionPhase

  /// หมายเหตุความเสียหาย (แก้ไขได้ตาม CRUD Matrix)
  damageNote   String? @db.Text
  hasNewDamage Boolean @default(false)

  inspectedById Int
  inspectedAt   DateTime @default(now())

  order  RentalOrder       @relation(fields: [orderId], references: [id])
  unit   EquipmentUnit     @relation(fields: [equipmentUnitId], references: [id])
  by     User              @relation("InspectionInspector", fields: [inspectedById], references: [id])
  photos InspectionPhoto[]

  @@index([orderId])
  @@index([equipmentUnitId])
}

model InspectionPhoto {
  id       Int        @id @default(autoincrement())
  logId    Int
  angle    PhotoAngle
  imageUrl String     @db.VarChar(500)
  caption  String?    @db.VarChar(255)

  log InspectionLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId])
}

/// รอบบำรุงรักษา/ทำความสะอาด — REQ-RISK-003
model MaintenanceRecord {
  id              Int               @id @default(autoincrement())
  equipmentUnitId Int
  reason          MaintenanceReason
  /// true = ระบบสร้างเองจากตัวนับ, false = Admin สั่ง
  isAutomatic     Boolean           @default(false)

  note        String?   @db.Text
  cost        Decimal?  @db.Decimal(10, 2)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  unit EquipmentUnit @relation(fields: [equipmentUnitId], references: [id])

  @@index([equipmentUnitId])
  @@index([completedAt])
}

// ------------------------------------------------------------
//  AI MARKETING
// ------------------------------------------------------------

/// โพสโปรโมชั่นที่ AI ร่างจากอุปกรณ์ที่คิวว่างนาน — REQ-AI-002
model AiMarketingPost {
  id          Int        @id @default(autoincrement())
  equipmentId Int?
  status      PostStatus @default(DRAFT)

  headline String @db.VarChar(200)
  caption  String @db.Text
  /// จุดเด่นอุปกรณ์ที่ AI สรุปมา เก็บเป็น JSON array of string
  highlights Json?

  /// เหตุผลที่ AI หยิบอุปกรณ์ชิ้นนี้มาโปรโมต เช่น "คิวว่างต่อเนื่อง 9 วัน"
  triggerReason String? @db.VarChar(255)
  idleDays      Int?

  generatedAt  DateTime  @default(now())
  approvedById Int?
  broadcastAt  DateTime?

  equipment  Equipment? @relation(fields: [equipmentId], references: [id])
  approvedBy User?      @relation("PostApprover", fields: [approvedById], references: [id])

  @@index([status])
  @@index([equipmentId])
}

// ------------------------------------------------------------
//  ACTIVITY FEED
// ------------------------------------------------------------

/// เหตุการณ์ในระบบ ใช้เรนเดอร์ feed หน้า Dashboard
model ActivityLog {
  id      Int          @id @default(autoincrement())
  type    ActivityType
  message String       @db.VarChar(500)

  /// ผู้กระทำ — null = ระบบทำอัตโนมัติ
  actorId Int?
  /// อ้างอิงกลับไปยัง entity ต้นทาง (order / unit / post)
  refType String? @db.VarChar(40)
  refId   Int?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([type])
}
