# ============================================================
#  คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ
#      cp .env.example .env
#  ไฟล์ .env จะไม่ถูก commit ขึ้น git (ห้ามใส่ค่าจริงในไฟล์นี้)
# ============================================================

# ---- Database ----
# รูปแบบ: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# XAMPP ตั้งค่า root ไม่มีรหัสผ่านมาให้ตั้งแต่แรก จึงเว้นว่างหลัง ":"
DATABASE_URL="mysql://root:@127.0.0.1:3306/dacamera_rental"

# ---- Gemini API (REQ-AI-001 / REQ-AI-002) ----
# ขอ key ได้ที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ไม่ตั้งก็ได้ — ค่าเริ่มต้นคือ gemini-flash-latest
# หลีกเลี่ยงการตรึงเลขเวอร์ชัน เพราะ Google ปิดรุ่นเก่าไม่ให้ผู้ใช้ใหม่เรียกเป็นระยะ
GEMINI_MODEL=""

# ---- Session ----
# ใช้เซ็น JWT ของ session ต้องยาวอย่างน้อย 32 ตัวอักษร
# สร้างของตัวเองด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
